---
import BaseLayout from "./BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE, withBase } from "../site";

interface Heading { depth: number; slug: string; text: string; }
interface Props {
  title: string;
  description: string;
  headings: Heading[];
  id: string;
}
const { title, description, headings, id } = Astro.props;

const all = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const href = (docId: string) => withBase(docId === "index" ? "/docs" : `/docs/${docId}`);

// Group in sidebar order, first-seen wins.
const groups: { name: string; items: typeof all }[] = [];
for (const doc of all) {
  let g = groups.find((x) => x.name === doc.data.group);
  if (!g) groups.push((g = { name: doc.data.group, items: [] }));
  g.items.push(doc);
}

const index = all.findIndex((d) => d.id === id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;

const onThisPage = headings.filter((h) => h.depth === 2 || h.depth === 3);
const canonical = new URL(href(id), SITE.url).href;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonical,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: `${SITE.name} documentation`, url: `${SITE.url}/docs` },
    author: { "@type": "Organization", name: SITE.studio, url: SITE.studioUrl },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Docs", item: `${SITE.url}/docs` },
      ...(id === "index" ? [] : [{ "@type": "ListItem", position: 3, name: title, item: canonical }]),
    ],
  },
];
---

<BaseLayout title={title} description={description} type="article" schema={schema}>
  <div class="wrap shell">
    <aside class="side">
      <nav aria-label="Documentation">
        {groups.map((g) => (
          <div class="group">
            <h2>{g.name}</h2>
            <ul>
              {g.items.map((doc) => (
                <li>
                  <a href={href(doc.id)} aria-current={doc.id === id ? "page" : undefined}>
                    {doc.data.sidebarLabel ?? doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article class="doc">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase("/")}>Home</a><span aria-hidden="true">/</span>
        <a href={withBase("/docs")}>Docs</a>
        {id !== "index" && (<><span aria-hidden="true">/</span><span aria-current="page">{title}</span></>)}
      </nav>

      <h1>{title}</h1>
      <p class="doc-lede">{description}</p>

      <div class="prose"><slot /></div>

      <nav class="pager" aria-label="Pagination">
        {prev ? (
          <a href={href(prev.id)} class="pager-link">
            <span class="pager-dir">Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next && (
          <a href={href(next.id)} class="pager-link pager-link--next">
            <span class="pager-dir">Next</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    </article>

    <aside class="toc">
      {onThisPage.length > 0 && (
        <nav aria-label="On this page">
          <h2>On this page</h2>
          <ul>
            {onThisPage.map((h) => (
              <li class:list={{ sub: h.depth === 3 }}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: 1300px;
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr) 190px;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-top: 2.75rem;
  }

  /* ── sidebar ── */
  .side, .toc {
    position: sticky;
    top: 86px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 0.89rem;
  }
  .group + .group { margin-top: 1.6rem; }
  .group h2, .toc h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }
  .side ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .side a {
    display: block;
    padding: 0.32rem 0.7rem;
    margin-left: -0.7rem;
    border-radius: 6px;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .side a:hover { color: var(--text); background: var(--surface); }
  .side a[aria-current="page"] {
    color: var(--signal-bright);
    background: var(--signal-dim);
    font-weight: 600;
  }

  /* ── toc ── */
  .toc a {
    display: block;
    padding: 0.24rem 0;
    color: var(--text-faint);
    text-decoration: none;
    font-size: 0.83rem;
    line-height: 1.4;
    transition: color 0.15s ease;
  }
  .toc a:hover { color: var(--signal-bright); }
  .toc li.sub a { padding-left: 0.85rem; font-size: 0.79rem; }

  /* ── article ── */
  .crumbs {
    display: flex;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-bottom: 1.1rem;
  }
  .crumbs a { color: var(--text-faint); text-decoration: none; }
  .crumbs a:hover { color: var(--signal-bright); }

  .doc h1 {
    font-size: clamp(2rem, 4.2vw, 2.85rem);
    letter-spacing: -0.03em;
  }
  .doc-lede {
    margin-top: 0.9rem;
    font-size: 1.06rem;
    color: var(--text-muted);
    max-width: var(--measure);
    line-height: 1.6;
  }

  /* ── pager ── */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .pager-link:hover { border-color: var(--signal); }
  .pager-link--next { text-align: right; grid-column: 2; }
  .pager-dir {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .pager-title { font-weight: 600; font-size: 0.94rem; }

  @media (max-width: 1080px) {
    .shell { grid-template-columns: 200px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 820px) {
    .shell { grid-template-columns: 1fr; }
    .side {
      position: static;
      max-height: none;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line-soft);
      margin-bottom: 1.5rem;
    }
    .side nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.2rem; }
    .group + .group { margin-top: 0; }
    .pager { grid-template-columns: 1fr; }
    .pager-link--next { grid-column: 1; }
  }
</style>

<style is:global>
  /* ── long-form prose ── */
  .prose { margin-top: 2.5rem; max-width: var(--measure); }
  .prose > * + * { margin-top: 1.15rem; }
  .prose h2 {
    font-size: 1.55rem;
    margin-top: 3rem;
    padding-top: 0.4rem;
    letter-spacing: -0.022em;
    scroll-margin-top: 5.5rem;
  }
  .prose h3 {
    font-size: 1.16rem;
    margin-top: 2.1rem;
    scroll-margin-top: 5.5rem;
  }
  .prose p, .prose li { color: var(--text-muted); }
  .prose strong { color: var(--text); font-weight: 600; }
  .prose a { color: var(--signal-bright); text-underline-offset: 3px; }
  .prose ul, .prose ol { padding-left: 1.3rem; display: grid; gap: 0.45rem; }
  .prose li::marker { color: var(--text-faint); }
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.14em 0.4em;
    border-radius: 5px;
    background: var(--surface-2);
    border: 1px solid var(--line-soft);
    color: var(--text);
  }
  .prose pre {
    padding: 1.05rem 1.2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .prose pre code { background: none; border: 0; padding: 0; font-size: inherit; }

  /* Shiki emits the light theme's colours inline and the dark theme's as custom
     properties. Scoping to .github-light means the rule only matches dual-theme
     output — if that config ever changes, the inline colours win instead of the
     block losing all colour to an undefined variable. */
  :root[data-theme="dark"] .prose .astro-code.github-light,
  :root[data-theme="dark"] .prose .astro-code.github-light span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
  .prose blockquote {
    margin-inline: 0;
    padding: 0.9rem 1.2rem;
    border-left: 2px solid var(--rewrite);
    background: var(--rewrite-dim);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .prose blockquote > * + * { margin-top: 0.6rem; }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose th, .prose td {
    text-align: left;
    padding: 0.62rem 0.9rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .prose th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
  }
  .prose td { color: var(--text-muted); }
  .prose hr { border: 0; border-top: 1px solid var(--line-soft); margin-block: 2.5rem; }
</style>
