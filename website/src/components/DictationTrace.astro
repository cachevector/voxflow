---
/**
 * The signature element: one dictation, traced end to end.
 *
 * Every number on the ruler is the real budget from docs/performance-budget.md,
 * and the three rows are the three things VoxFlow actually does — capture the
 * audio, transcribe it, then rewrite it before it lands at your cursor.
 * Cyan marks live audio; amber marks the AI rewrite pass, the same way the
 * colour is used everywhere else on this site.
 */

// Fixed, hand-tuned envelope: silence, speech, silence. The flat ends are the
// part VAD trims away, so the shape itself explains the "silence trimmed" label.
const bars = [
  2, 3, 2, 4, 3, 12, 26, 41, 34, 52, 63, 48, 71, 58, 44, 66, 78, 61, 47, 69,
  82, 57, 40, 63, 74, 51, 66, 88, 72, 55, 68, 47, 59, 71, 45, 33, 52, 38, 24,
  31, 18, 22, 12, 9, 5, 3, 2, 3,
];
const SPEECH_START = 5;
const SPEECH_END = 45;

const raw = "um so can you uh check whether the the cache is warm before we ship";
const clean = "Can you check whether the cache is warm before we ship?";

// `shift` keeps the first and last labels inside the panel instead of centring
// them on a tick that sits at the very edge of the track.
const marks = [
  { at: "0%", shift: "0", align: "flex-start", label: "80 ms", note: "pill appears" },
  { at: "28%", shift: "-50%", align: "center", label: "100 ms", note: "capturing" },
  { at: "54%", shift: "-50%", align: "center", label: "250 ms", note: "speech ends" },
  { at: "76%", shift: "-50%", align: "center", label: "800 ms", note: "transcribed" },
  { at: "100%", shift: "-100%", align: "flex-end", label: "1.5 s", note: "inserted" },
];
---

<figure class="trace" aria-labelledby="trace-caption">
  <div class="chrome">
    <span class="dot" aria-hidden="true"></span>
    <span class="held"><kbd>⌥</kbd><kbd>⌃</kbd> held</span>
    <span class="spacer"></span>
    <span class="mono meta">whisper.cpp · metal · on-device</span>
  </div>

  <!-- 1. Audio -->
  <div class="row row--wave">
    <span class="tag">audio in</span>
    <div class="wave" role="img" aria-label="Waveform of a spoken phrase, with silence trimmed from both ends">
      {bars.map((h, i) => (
        <span
          class:list={["bar", { "bar--silent": i < SPEECH_START || i > SPEECH_END }]}
          style={`--h:${h}%; --i:${i}`}
        ></span>
      ))}
      <span class="gate gate--in" style={`left:${(SPEECH_START / bars.length) * 100}%`}></span>
      <span class="gate gate--out" style={`left:${((SPEECH_END + 1) / bars.length) * 100}%`}></span>
    </div>
    <span class="mono trimmed">−1.2 s silence trimmed</span>
  </div>

  <!-- 2. Transcript -->
  <div class="row">
    <span class="tag">transcript</span>
    <p class="line line--raw">{raw}</p>
  </div>

  <!-- 3. Rewrite -->
  <div class="row">
    <span class="tag tag--rewrite">rewrite</span>
    <p class="line line--clean">{clean}<span class="caret" aria-hidden="true"></span></p>
  </div>

  <!-- Latency ruler -->
  <div class="ruler" aria-hidden="true">
   <div class="ruler-inner">
    <span class="track"></span>
    {marks.map((m) => (
      <span class="mark" style={`left:${m.at}; --shift:${m.shift}; --align:${m.align}`}>
        <span class="tick"></span>
        <span class="mono mark-label">{m.label}</span>
        <span class="mark-note">{m.note}</span>
      </span>
    ))}
   </div>
  </div>

  <figcaption id="trace-caption" class="sr-only">
    A dictation traced end to end: audio is captured and silence-trimmed, transcribed on
    device by Whisper, rewritten into a clean sentence, and inserted at the cursor — all
    within the 1.5 second budget.
  </figcaption>
</figure>

<style>
  .trace {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--signal) 5%, var(--surface)), var(--surface));
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- title bar --- */
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line-soft);
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--signal) 55%, transparent); }
    70%, 100% { box-shadow: 0 0 0 9px transparent; }
  }
  .held { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--text-muted); }
  .spacer { flex: 1; }
  .meta { font-size: 0.72rem; letter-spacing: 0.02em; }
  .mono { font-family: var(--font-mono); }

  /* --- rows --- */
  .row {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .tag--rewrite { color: var(--rewrite); }

  /* --- waveform --- */
  .wave {
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    height: 56px;
  }
  .bar {
    flex: 1;
    height: var(--h);
    min-height: 2px;
    border-radius: 2px;
    background: var(--signal);
    transform-origin: center;
    opacity: 0.9;
    animation: rise 0.42s cubic-bezier(0.2, 0.9, 0.3, 1) both;
    animation-delay: calc(120ms + var(--i) * 26ms);
  }
  .bar--silent { background: var(--text-faint); opacity: 0.32; }
  @keyframes rise {
    from { transform: scaleY(0.06); }
    to { transform: scaleY(1); }
  }

  .gate {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: var(--rewrite);
    opacity: 0.55;
    animation: fade 0.4s ease both 1.45s;
  }
  .gate::after {
    content: "";
    position: absolute;
    inset-block: 0;
    width: 5px;
    border: 1px solid var(--rewrite);
    border-left: 0;
    left: 0;
  }
  .gate--out::after { border: 1px solid var(--rewrite); border-right: 0; left: -5px; }
  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 0.55; }
  }

  .trimmed { font-size: 0.72rem; color: var(--text-faint); white-space: nowrap; }

  /* --- text rows --- */
  .line {
    grid-column: 2 / -1;
    font-size: clamp(0.95rem, 1.6vw, 1.08rem);
    animation: fadeUp 0.5s ease both;
  }
  .line--raw {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    animation-delay: 1.7s;
  }
  .line--clean {
    color: var(--text);
    font-weight: 500;
    animation-delay: 2.3s;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: none; }
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: text-bottom;
    background: var(--rewrite);
    animation: blink 1.1s steps(1) infinite 2.8s;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* --- ruler --- */
  .ruler {
    height: 62px;
    padding: 0 1.15rem;
    background: color-mix(in srgb, var(--ground) 55%, var(--surface));
  }
  /* Track and ticks share one inset box, so 0% and 100% land on the track ends. */
  .ruler-inner { position: relative; height: 100%; }
  .track {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    height: 1px;
    background: linear-gradient(90deg, var(--signal), var(--rewrite));
    opacity: 0.4;
    transform-origin: left;
    animation: sweep 2.4s cubic-bezier(0.3, 0.8, 0.3, 1) both 0.1s;
  }
  @keyframes sweep {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .mark {
    position: absolute;
    top: 8px;
    transform: translateX(var(--shift, -50%));
    display: flex;
    flex-direction: column;
    align-items: var(--align, center);
    gap: 2px;
    animation: fadeIn 0.35s ease both;
  }
  .mark:nth-of-type(2) { animation-delay: 0.35s; }
  .mark:nth-of-type(3) { animation-delay: 0.85s; }
  .mark:nth-of-type(4) { animation-delay: 1.4s; }
  .mark:nth-of-type(5) { animation-delay: 2s; }
  .mark:nth-of-type(6) { animation-delay: 2.5s; }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .tick { width: 1px; height: 12px; background: var(--line); }
  .mark-label { font-size: 0.72rem; font-weight: 500; color: var(--text-muted); }
  .mark-note { font-size: 0.66rem; color: var(--text-faint); white-space: nowrap; }

  @media (max-width: 720px) {
    .row { grid-template-columns: 1fr; gap: 0.5rem; padding: 0.9rem 1rem; }
    .line { grid-column: 1; }
    .trimmed { display: none; }
    .mark-note { display: none; }
    .meta { display: none; }
    .wave { height: 44px; }
  }
</style>
