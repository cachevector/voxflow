---
// Reduced VoxFlow mark: the mic capsule + pickup arc from the app's overlay pill
// (src/overlay/components/LogoMark.tsx), so the site and the product agree.
interface Props { size?: number; }
const { size = 26 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  aria-hidden="true"
  class="mark"
>
  <rect x="9" y="2" width="6" height="11" rx="3" fill="currentColor" stroke="none" />
  <path d="M6 11.5v.5a6 6 0 0 0 12 0v-.5" />
  <path d="M12 19.5V22" />
</svg>
<style>
  .mark { color: var(--signal); flex: none; }
</style>
