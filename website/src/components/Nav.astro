---
import Logo from "./Logo.astro";
import { NAV, SITE, withBase } from "../site";

const path = Astro.url.pathname.replace(/\/$/, "");

function isCurrent(href: string) {
  if (href.includes("#")) return false;
  const target = withBase(href).replace(/\/$/, "");
  return path === target || path.startsWith(`${target}/`);
}

function sectionId(href: string) {
  const hash = href.split("#")[1];
  return hash || undefined;
}
---
<header class="bar" data-nav>
  <div class="wrap">
    <div class="island">
      <a href={withBase("/")} class="brand" aria-label="VoxFlow home">
        <Logo />
        <span class="word">VoxFlow</span>
        <span class="plat">macOS</span>
      </a>

      <nav class="links" id="site-nav" aria-label="Main">
        {NAV.map((item) => (
          <a
            href={withBase(item.href)}
            data-section={sectionId(item.href)}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >{item.label}</a>
        ))}
      </nav>

      <div class="actions">
        <button type="button" id="theme-toggle" class="icon-btn" aria-label="Switch to light theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
          </svg>
        </button>
        <a class="btn btn--primary cta" href={SITE.download} rel="noopener" aria-label="Download VoxFlow for macOS">
          Download<span class="cta-extra">for Mac</span>
        </a>
        <button
          type="button"
          class="icon-btn menu-btn"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open menu"
        >
          <svg class="icon-wave" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <rect x="3" y="9" width="2.6" height="6" rx="1.3" fill="currentColor" />
            <rect x="8.1" y="5" width="2.6" height="14" rx="1.3" fill="currentColor" />
            <rect x="13.3" y="7.5" width="2.6" height="9" rx="1.3" fill="currentColor" />
            <rect x="18.4" y="10" width="2.6" height="4" rx="1.3" fill="currentColor" />
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-nav]");
    if (!root) return;
    const themeBtn = document.getElementById("theme-toggle");
    const menuBtn = root.querySelector(".menu-btn");
    const nav = document.getElementById("site-nav");

    const syncTheme = () => {
      if (!themeBtn) return;
      const light = document.documentElement.dataset.theme === "light";
      themeBtn.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
    };
    themeBtn?.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("voxflow-theme", next); } catch {}
      syncTheme();
    });
    syncTheme();

    const setOpen = (open) => {
      root.classList.toggle("is-open", open);
      menuBtn?.setAttribute("aria-expanded", open ? "true" : "false");
      menuBtn?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    menuBtn?.addEventListener("click", () => setOpen(!root.classList.contains("is-open")));
    nav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target)) setOpen(false);
    });

    const sectionLinks = [...root.querySelectorAll("[data-section]")];
    const sections = sectionLinks
      .map((a) => document.getElementById(a.dataset.section))
      .filter(Boolean);
    if (sections.length === 0) return;

    const setActive = (id) => {
      sectionLinks.forEach((a) => {
        const on = a.dataset.section === id;
        a.toggleAttribute("data-active", on);
        if (on) a.setAttribute("aria-current", "location");
        else if (a.getAttribute("aria-current") === "location") a.removeAttribute("aria-current");
      });
    };

    const tick = () => {
      let current = "";
      for (const el of sections) {
        if (el.getBoundingClientRect().top < 120) current = el.id;
      }
      setActive(current);
    };
    tick();
    window.addEventListener("scroll", tick, { passive: true });
    window.addEventListener("hashchange", () => {
      const id = location.hash.replace("#", "");
      if (id) setActive(id);
    });
  })();
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.7rem 0 0.55rem;
    background: linear-gradient(to bottom, var(--ground) 55%, transparent);
  }

  .island {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 56px;
    padding: 0.4rem 0.45rem 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.35);
    box-shadow: var(--shadow);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.04rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .word { line-height: 1; }
  .plat {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.18rem 0.42rem 0.14rem;
    line-height: 1;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-inline: auto;
    padding: 0.18rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ground) 55%, transparent);
    border: 1px solid var(--line-soft);
  }
  .links a {
    position: relative;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.38rem 0.78rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .links a:hover {
    color: var(--text);
  }
  .links a[aria-current],
  .links a[data-active] {
    color: var(--signal-bright);
    background: var(--signal-dim);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    margin-left: 0;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--signal);
    background: var(--signal-dim);
  }
  .icon-moon,
  .icon-close { display: none; }
  :global(:root[data-theme="light"]) .icon-sun { display: none; }
  :global(:root[data-theme="light"]) .icon-moon { display: block; }

  .cta {
    gap: 0;
    padding: 0.48rem 0.95rem;
    font-size: 0.86rem;
    border-radius: 999px;
  }
  .cta-extra { margin-left: 0.3em; }
  .menu-btn { display: none; }

  @media (max-width: 860px) {
    .island {
      flex-wrap: wrap;
      border-radius: 22px;
      padding: 0.45rem 0.5rem 0.45rem 0.75rem;
    }
    .links {
      display: none;
      flex: 1 1 100%;
      order: 3;
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
      margin: 0.15rem 0 0;
      padding: 0.35rem;
      border-radius: 16px;
    }
    .links a {
      padding: 0.62rem 0.8rem;
      white-space: normal;
    }
    .bar.is-open .links { display: flex; }
    .menu-btn { display: grid; }
    .bar.is-open .icon-wave { display: none; }
    .bar.is-open .icon-close { display: block; }
    .plat { display: none; }
  }

  @media (max-width: 520px) {
    .cta-extra { display: none; }
    .word { font-size: 0.98rem; }
  }
</style>
