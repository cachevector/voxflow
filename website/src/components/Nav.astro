---
import Logo from "./Logo.astro";
import { NAV, SITE, withBase } from "../site";
const path = Astro.url.pathname;
---
<header class="bar">
  <div class="wrap inner">
    <a href={withBase("/")} class="brand" aria-label="VoxFlow home">
      <Logo />
      <span>VoxFlow</span>
    </a>

    <nav class="links" aria-label="Main">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          data-primary={item.href === "/docs" ? "" : undefined}
          aria-current={!item.href.includes("#") && path.startsWith(withBase(item.href)) ? "page" : undefined}
        >{item.label}</a>
      ))}
    </nav>

    <div class="actions">
      <button type="button" id="theme-toggle" class="icon-btn" aria-label="Switch to light theme">
        <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z" />
        </svg>
      </button>
      <a class="btn btn--primary cta" href={SITE.download} rel="noopener">Download</a>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const sync = () => {
      const light = document.documentElement.dataset.theme === "light";
      btn.setAttribute("aria-label", light ? "Switch to dark theme" : "Switch to light theme");
    };
    btn.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("voxflow-theme", next); } catch {}
      sync();
    });
    sync();
  })();
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ground) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--line-soft);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 62px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.06rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 1.4rem;
    margin-inline: auto;
    font-size: 0.92rem;
  }
  .links a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .links a:hover,
  .links a[aria-current="page"] {
    color: var(--text);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .icon-btn:hover { color: var(--text); border-color: var(--signal); }
  /* Dark mode shows a sun (tap for light); light mode shows a moon. */
  .icon-moon { display: none; }
  :global(:root[data-theme="light"]) .icon-sun { display: none; }
  :global(:root[data-theme="light"]) .icon-moon { display: block; }
  .cta { padding: 0.5rem 0.9rem; font-size: 0.88rem; }

  /* On narrow screens the marketing anchors are all reachable by scrolling the
     page they point into, so only Docs — a separate destination — stays. */
  @media (max-width: 760px) {
    .links { gap: 0; margin-inline: 0; }
    .links a:not([data-primary]) { display: none; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 420px) {
    .cta { padding: 0.5rem 0.7rem; }
  }
</style>
