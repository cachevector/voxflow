{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxFlow",
  "version": "0.1.0",
  "identifier": "com.maskedsyntax.voxflow",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": "pnpm exec vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxFlow",
        "url": "index.html",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "overlay",
        "title": "VoxFlow",
        "url": "overlay.html",
        "width": 360,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "macOS": {
      "signingIdentity": "Apple Development: aftaab2507@gmail.com (FC84RQ83VB)",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
